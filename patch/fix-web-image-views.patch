From 75944815036cb64eaf6ee6898e2d62484a527d47 Mon Sep 17 00:00:00 2001
From: rydmike <mrydstrom+gh@gmail.com>
Date: Sun, 8 Nov 2026 18:15:58 +0200
Subject: [PATCH] Give web Ore image views a texture before the browser decode
 lands

On the web, scripted GPU canvases that sample a file image through Image:view() draw nothing, and every pass that binds the view drops its draws ("skip make wrapImageView ... unresolved dep", then "bindGroup '' skipped, unresolved dependency").

Two causes in the deferred replay:

1. The Ore image resolver in DeferredReplayer returned a resident 2D image unprepped. On the web that is a context agnostic WebGL2RenderImage, which only prep() turns into the RiveRenderImage the wrap needs, so the lite_rtti_cast in the wrapImageView make always failed. Foreign images were already prepped.

2. The recorder reads image sizes from the encoded header (DeferredFactory::decodeImage), so a script sees width > 0 on its first frame and records the view then. The replay decodes its own copy through the browser, asynchronously, so the first replay finds it still decoding. The wrap and the bind groups made on it are recorded once, so the skip is permanent, where a 2D draw or a paint asks again next frame.

DeferredFrameSink gains prepOreImage, used for both image kinds, which defaults to prepForeignImage. The WebGL sink answers it with WebGL2RenderImage::prepForWrap: a still decoding image gets a zero filled, mipmapped texture at its header size, and setWebImage uploads into that same texture when the decode lands. GL Ore views borrow the texture id, so the view and its bind groups pick up the image with no replay change. Native sinks keep their behaviour.
---
 native/platform/wasm/webgl_factory.cpp        | 113 ++++++++++++++++++
 .../rive/renderer/cmd/deferred_replayer.hpp   |  27 +++--
 2 files changed, 131 insertions(+), 9 deletions(-)

diff --git a/native/platform/wasm/webgl_factory.cpp b/native/platform/wasm/webgl_factory.cpp
index 29edf69..cc3088c 100644
--- a/native/platform/wasm/webgl_factory.cpp
+++ b/native/platform/wasm/webgl_factory.cpp
@@ -231,6 +231,11 @@ public:
   {
     m_Width = 0;
     m_Height = 0;
+#if defined(RIVE_CANVAS) && defined(RIVE_ORE)
+    // Header size, so an Ore view can have its texture before the decode
+    // lands (prepForWrap). Width and height stay 0 until then.
+    rive::cmd::sniffImageSize(encodedBytes, m_headerWidth, m_headerHeight);
+#endif
 
     ref();
     decode_image(
@@ -253,6 +258,7 @@ public:
     m_Width = width;
     m_Height = height;
     m_readyToUpload = true;
+    uploadIntoEarlyTexture();
     decodedAsync();
   }
 
@@ -260,11 +266,24 @@ private:
   bool m_readyToUpload = false;
   EMSCRIPTEN_WEBGL_CONTEXT_HANDLE m_contextGL = 0;
   rcp<RiveRenderImage> m_renderImage;
+  int m_headerWidth = 0;
+  int m_headerHeight = 0;
+  // A texture prepForWrap made before the decode landed, still empty.
+  GLuint m_earlyTexture = 0;
+
+  void uploadIntoEarlyTexture();
 
 public:
   RenderImage* prep(
       WebGL2Renderer* webglRenderer,
       const EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context);
+
+  // prep for a wrap that is made once, such as an Ore image view: a still
+  // decoding image gets a transparent texture at its header size, which the
+  // decode fills in when it lands. Null only when the size is unknown.
+  RenderImage* prepForWrap(
+      WebGL2Renderer* webglRenderer,
+      const EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context);
 };
 
 EXPORT void setWebImage(WebGL2RenderImage* renderImage, int width, int height)
@@ -785,6 +804,16 @@ public:
                : image;
   }
 
+  // An Ore view wraps its image once, and the browser decode usually lands
+  // a frame or more after the first replay that asks for it.
+  rive::RenderImage* prepOreImage(rive::RenderImage* image) override
+  {
+    auto* webglImage = lite_rtti_cast<WebGL2RenderImage*>(image);
+    return webglImage != nullptr
+               ? webglImage->prepForWrap(m_renderer, m_renderer->contextGL())
+               : image;
+  }
+
   rive::Renderer* beginScreen(uint64_t target, bool clear, uint32_t color)
       override
   {
@@ -943,6 +972,8 @@ RenderImage* WebGL2RenderImage::prep(
   // otherwise we need to re-upload.
   if (context == m_contextGL && m_renderImage)
   {
+    // An early texture whose upload could not run when the decode landed.
+    uploadIntoEarlyTexture();
     return m_renderImage.get();
   }
   if (m_readyToUpload)
@@ -952,6 +983,7 @@ RenderImage* WebGL2RenderImage::prep(
       // Make sure to reset image on old context.
       ScopedGLContextMakeCurrent makeCurrent(m_contextGL);
       m_renderImage = nullptr;
+      m_earlyTexture = 0;
     }
     ScopedGLContextMakeCurrent makeCurrent(m_contextGL = context);
     if (!makeCurrent.ok())
@@ -981,9 +1013,90 @@ RenderImage* WebGL2RenderImage::prep(
         webglRenderer->renderContextGL()
             ->adoptImageTexture(m_Width, m_Height, textureId));
   }
+  // Still decoding, with an early texture on another context: contexts do
+  // not share textures, so there is nothing to hand out yet.
+  return context == m_contextGL ? m_renderImage.get() : nullptr;
+}
+
+RenderImage* WebGL2RenderImage::prepForWrap(
+    WebGL2Renderer* webglRenderer,
+    const EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context)
+{
+  if (m_readyToUpload || m_renderImage || m_headerWidth <= 0 ||
+      m_headerHeight <= 0)
+  {
+    // Decoded, already has a texture, or no size to make one at.
+    return prep(webglRenderer, context);
+  }
+  ScopedGLContextMakeCurrent makeCurrent(m_contextGL = context);
+  if (!makeCurrent.ok())
+  {
+    return nullptr;
+  }
+  GLuint textureId = 0;
+  glGenTextures(1, &textureId);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, textureId);
+  webglRenderer->renderContextGL()->state()->bindBuffer(
+      GL_PIXEL_UNPACK_BUFFER,
+      0);
+  // WebGL zero fills a null upload, so it samples transparent until the
+  // decode lands. The mips make it complete for a mipmapped sampler.
+  glTexImage2D(
+      GL_TEXTURE_2D,
+      0,
+      GL_RGBA,
+      m_headerWidth,
+      m_headerHeight,
+      0,
+      GL_RGBA,
+      GL_UNSIGNED_BYTE,
+      nullptr);
+  glGenerateMipmap(GL_TEXTURE_2D);
+  glTexParameteri(
+      GL_TEXTURE_2D,
+      GL_TEXTURE_MIN_FILTER,
+      GL_LINEAR_MIPMAP_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  m_earlyTexture = textureId;
+  m_renderImage = make_rcp<RiveRenderImage>(
+      webglRenderer->renderContextGL()
+          ->adoptImageTexture(m_headerWidth, m_headerHeight, textureId));
   return m_renderImage.get();
 }
 
+void WebGL2RenderImage::uploadIntoEarlyTexture()
+{
+  if (m_earlyTexture == 0 || !m_readyToUpload)
+  {
+    return;
+  }
+  ScopedGLContextMakeCurrent makeCurrent(m_contextGL);
+  if (!makeCurrent.ok())
+  {
+    return; // the next prep on this context retries
+  }
+  // Runs between frames when the decode lands, or inside one from prep, so
+  // every binding it touches goes back the way it was.
+  GLint activeTexture = 0, boundTexture = 0, unpackBuffer = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTexture);
+  glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpackBuffer);
+  glActiveTexture(GL_TEXTURE0);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &boundTexture);
+  glBindTexture(GL_TEXTURE_2D, m_earlyTexture);
+  glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+  upload_image(
+      emscripten_webgl_get_current_context(),
+      reinterpret_cast<uintptr_t>(this));
+  glGenerateMipmap(GL_TEXTURE_2D);
+  glBindBuffer(GL_PIXEL_UNPACK_BUFFER, static_cast<GLuint>(unpackBuffer));
+  glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(boundTexture));
+  glActiveTexture(static_cast<GLenum>(activeTexture));
+  m_earlyTexture = 0;
+}
+
 PLSSynchronizedBuffer::PLSSynchronizedBuffer(
     WebGL2Renderer* webglRenderer,
     WebGL2RenderBuffer* webglBuffer)
diff --git a/runtime/renderer/include/rive/renderer/cmd/deferred_replayer.hpp b/runtime/renderer/include/rive/renderer/cmd/deferred_replayer.hpp
index 4516e0c..6c69076 100644
--- a/runtime/renderer/include/rive/renderer/cmd/deferred_replayer.hpp
+++ b/runtime/renderer/include/rive/renderer/cmd/deferred_replayer.hpp
@@ -83,6 +83,16 @@ public:
   // already RiveRenderImages by the time they reach replay. Also asked for
   // the decoded images a paint samples, null leaving that paint unimaged.
   virtual RenderImage* prepForeignImage(RenderImage* image) { return image; }
+
+  // The image an Ore image view wraps. The wrap is made once, so a null here
+  // loses the view and every bind group made on it for good, where a 2D draw
+  // or a paint simply asks again next frame. Backends whose images decode
+  // asynchronously return a texture that fills in when the decode lands;
+  // the default preps like a foreign image.
+  virtual RenderImage* prepOreImage(RenderImage* image)
+  {
+    return prepForeignImage(image);
+  }
 };
 
 // Immutable snapshot of one recorded frame so the producer can record the next
@@ -343,15 +353,14 @@ private:
             // A flagged id is a foreign image the recorder was handed
             // rather than created, so it lives in the registry, not
             // the 2D mint space. Same convention drawImage uses.
-            if (imageId & kCanvasHandleFlag)
-            {
-              RenderImage* foreign = canvasImage(imageId & kCanvasHandleMask);
-              return foreign != nullptr ? sink.prepForeignImage(foreign)
-                                        : nullptr;
-            }
-            // Resident 2D image, created by the hoisted create pass
-            // or an earlier frame.
-            return m_2d.images.get(imageId);
+            // Otherwise it is a resident 2D image, created by the
+            // hoisted create pass or an earlier frame. Both go through
+            // the sink: a resident image can be a context agnostic one
+            // (web) that only the sink turns into a RiveRenderImage.
+            RenderImage* image = (imageId & kCanvasHandleFlag)
+                                     ? canvasImage(imageId & kCanvasHandleMask)
+                                     : m_2d.images.get(imageId);
+            return image != nullptr ? sink.prepOreImage(image) : nullptr;
           });
       realOre->setRenderTarget(nullptr);
       sink.endOreFrame();
